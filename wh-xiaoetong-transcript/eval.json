{
  "skill": "wh-xiaoetong-transcript",
  "version": "1.0",
  "assertions": [
    {"id": "A01", "check": "SKILL.md 存在", "target": "SKILL.md"},
    {"id": "A02", "check": "SKILL.md 有 YAML frontmatter（name + description）", "regex": "^---\\nname: wh-xiaoetong-transcript"},
    {"id": "A03", "check": "SKILL.md 含 LIGHTNING 执行协议", "regex": "LIGHTNING"},
    {"id": "A04", "check": "SKILL.md 有 RED 必读 references/download-recipes.md", "regex": "download-recipes\\.md"},
    {"id": "A05", "check": "SKILL.md 行数 ≤ 300", "max_lines": 300},
    {"id": "A06", "check": "_meta.json 存在且可解析", "json_valid": "_meta.json"},
    {"id": "A07", "check": "_meta.json 有 version/created/reference_skills", "json_keys": ["version", "created", "reference_skills"]},
    {"id": "A08", "check": "golden_rules.md 存在", "target": "golden_rules.md"},
    {"id": "A09", "check": "golden_rules.md 规则数 ≥ 9", "count_regex": "^## 规则"},
    {"id": "A10", "check": "lifecycle-log.md 存在且含 v1.0", "regex": "v1\\.0"},
    {"id": "A11", "check": "references/ 文件数 ≥ 5", "dir_count": "references", "min": 5},
    {"id": "A12", "check": "references/env-setup.md 存在且非空", "file_nonempty": "references/env-setup.md"},
    {"id": "A13", "check": "references/browser-ext-setup.md 存在且非空", "file_nonempty": "references/browser-ext-setup.md"},
    {"id": "A14", "check": "references/download-recipes.md 存在且非空", "file_nonempty": "references/download-recipes.md"},
    {"id": "A15", "check": "references/naming-rules.md 存在且非空", "file_nonempty": "references/naming-rules.md"},
    {"id": "A16", "check": "references/troubleshooting.md 存在且非空", "file_nonempty": "references/troubleshooting.md"},
    {"id": "A17", "check": "references/negative-results.md 存在且非空", "file_nonempty": "references/negative-results.md"},
    {"id": "A18", "check": "scripts/ 可执行脚本数 ≥ 4", "dir_count": "scripts", "min": 4},
    {"id": "A19", "check": "scripts/setup_env.py 存在", "target": "scripts/setup_env.py"},
    {"id": "A20", "check": "scripts/verify_env.py 存在", "target": "scripts/verify_env.py"},
    {"id": "A21", "check": "scripts/fix_manifest.py 存在", "target": "scripts/fix_manifest.py"},
    {"id": "A22", "check": "scripts/pipeline.py 存在", "target": "scripts/pipeline.py"},
    {"id": "A23", "check": "scripts/xiaoetong_transcript.py 存在（转写引擎）", "target": "scripts/xiaoetong_transcript.py"},
    {"id": "A24", "check": "触发词 ≥ 15（description 中）", "count_regex_in_file": {"file": "SKILL.md", "regex": "触发词"}},
    {"id": "A25", "check": "SKILL.md 含反模式表 ≥ 5 条", "count_regex_in_file": {"file": "SKILL.md", "regex": "^\\| [0-9] \\|"}},
    {"id": "A26", "check": "SKILL.md 含案例库 ≥ 2", "count_regex_in_file": {"file": "SKILL.md", "regex": "案例"}},
    {"id": "A27", "check": "SKILL.md 含联动技能表", "regex": "联动技能"},
    {"id": "A28", "check": "无 README.md（skill 禁建）", "not_exists": "README.md"},
    {"id": "A29", "check": "无 CHANGELOG.md（skill 禁建）", "not_exists": "CHANGELOG.md"},
    {"id": "A30", "check": "无 INSTALLATION_GUIDE.md（skill 禁建）", "not_exists": "INSTALLATION_GUIDE.md"}
  ]
}
